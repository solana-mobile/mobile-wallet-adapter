{
    "name": "@solana-mobile/example-web-app",
    "author": "Steven Luscher <steven.luscher@solanamobile.com>",
    "repository": "https://github.com/solana-mobile/mobile-wallet-adapter",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.30.0",
    "scripts": {
        "build": "pnpm clean && tsc --noEmit && vite build",
        "check-types": "tsc --noEmit",
        "clean": "shx rm -rf out",
        "dev": "vite",
        "e2e": "node e2e/run.ts",
        "format:check": "prettier . --check --cache",
        "format:fix": "prettier . --write",
        "lint": "pnpm lint:check",
        "lint:check": "eslint src e2e vite.config.ts eslint.config.mjs",
        "lint:fix": "eslint src e2e vite.config.ts eslint.config.mjs --fix",
        "preinstall": "(cd ../../js/ && pnpm install && pnpm build)",
        "preview": "vite preview",
        "test": "vitest run",
        "tunnel:start": "ngrok http 3002"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@solana-mobile/mobile-wallet-adapter-protocol": "link:../../js/packages/mobile-wallet-adapter-protocol",
        "@solana-mobile/wallet-standard-mobile": "link:../../js/packages/wallet-standard-mobile",
        "@solana/wallet-standard-features": "^1.4.0",
        "@solana/wallet-standard-util": "^1.1.3",
        "@wallet-standard/app": "^1.1.1",
        "@wallet-standard/base": "^1.1.1",
        "@wallet-standard/features": "^1.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@noble/curves": "^2.4.0",
        "@noble/hashes": "^2.4.0",
        "@types/node": "26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.1.2",
        "agent-browser": "^0.41.0",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "happy-dom": "^21.0.4",
        "ngrok": "^4.3.3",
        "prettier": "3.9.10",
        "shx": "^0.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "ws": "^8.22.1"
    },
    "pnpm": {
        "overrides": {
            "ajv": "^6.14.0",
            "postcss": "^8.4.31",
            "uuid@<11.1.1": ">=11.1.1",
            "sharp@<0.35.0": ">=0.35.0",
            "jayson@<5.0.0": "^5.0.0"
        }
    }
}
