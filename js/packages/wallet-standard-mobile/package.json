{
    "name": "@solana-mobile/wallet-standard-mobile",
    "description": "A wallet-standard wallet for mobile wallet apps that conform to the Solana Mobile Wallet Adapter protocol",
    "version": "0.6.0",
    "author": "Marco Martinez <marco.martinez@solana.com>",
    "repository": "https://github.com/solana-mobile/mobile-wallet-adapter",
    "license": "Apache-2.0",
    "exports": {
        "types": "./lib/types/index.d.ts",
        "browser": "./lib/esm/index.browser.js",
        "react-native": "./lib/esm/index.native.js",
        "default": "./lib/esm/index.js"
    },
    "browser": {
        "./lib/esm/index.js": "./lib/esm/index.browser.js"
    },
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "react-native": "lib/esm/index.native.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "files": [
        "lib",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx rm -rf lib/*",
        "build": "pnpm clean && tsdown --config ../../tsdown.config.ts",
        "build:watch": "pnpm clean && tsdown --config ../../tsdown.config.ts --watch",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "agadoo"
    },
    "dependencies": {
        "@solana-mobile/mobile-wallet-adapter-protocol": "workspace:^",
        "@solana/wallet-standard-chains": "^1.1.1",
        "@solana/wallet-standard-features": "^1.5.0",
        "@wallet-standard/base": "^1.0.1",
        "@wallet-standard/features": "^1.0.3",
        "@wallet-standard/wallet": "^1.1.0",
        "qrcode": "^1.5.4",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@react-native-async-storage/async-storage": "^1.17.7 || ^2.0.0"
    },
    "peerDependenciesMeta": {
        "@react-native-async-storage/async-storage": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.5",
        "agadoo": "^3.0.0",
        "cross-env": "^10.1.0",
        "shx": "^0.4.0"
    }
}
