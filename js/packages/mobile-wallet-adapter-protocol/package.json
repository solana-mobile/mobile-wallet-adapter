{
    "name": "@solana-mobile/mobile-wallet-adapter-protocol",
    "description": "An implementation of the Solana Mobile Mobile Wallet Adapter protocol. Use this to open a session with a mobile wallet app, and to issue API calls to it.",
    "version": "2.3.0",
    "author": "Steven Luscher <steven.luscher@solanamobile.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/solana-mobile/mobile-wallet-adapter.git"
    },
    "license": "Apache-2.0",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "browser": "./lib/esm/index.browser.js",
            "react-native": "./lib/esm/index.native.js",
            "default": "./lib/esm/index.js"
        },
        "./encoding": {
            "types": "./lib/types/encoding.d.ts",
            "browser": "./lib/esm/encoding.browser.js",
            "react-native": "./lib/esm/encoding.native.js",
            "default": "./lib/esm/encoding.js"
        }
    },
    "browser": {
        "./lib/esm/encoding.js": "./lib/esm/encoding.browser.js",
        "./lib/esm/index.js": "./lib/esm/index.browser.js"
    },
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "react-native": "lib/esm/index.native.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "files": [
        "android",
        "src/codegenSpec",
        "!android/build",
        "lib",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx rm -rf lib/*",
        "build": "pnpm clean && tsdown --config ../../tsdown.config.ts",
        "build:watch": "pnpm clean && tsdown --config ../../tsdown.config.ts --watch",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "agadoo"
    },
    "dependencies": {
        "@noble/curves": "^2.2.0",
        "@noble/hashes": "^2.2.0",
        "@solana/kit": "^7.0.0 || ^8.0.0",
        "@solana/wallet-standard-features": "^1.5.0",
        "@solana/wallet-standard-util": "^1.1.2",
        "@wallet-standard/core": "^1.1.1"
    },
    "devDependencies": {
        "@types/react-native": "^0.69.3",
        "agadoo": "^3.0.0",
        "cross-env": "^10.1.0",
        "shx": "^0.4.0"
    },
    "peerDependencies": {
        "react-native": ">0.74"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        }
    },
    "codegenConfig": {
        "name": "SolanaMobileWalletAdapter",
        "type": "all",
        "jsSrcsDir": "./src/codegenSpec",
        "android": {
            "javaPackageName": "com.solanamobile.mobilewalletadapter.reactnative"
        }
    }
}
