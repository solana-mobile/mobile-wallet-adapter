{
    "name": "@solana-mobile/mobile-wallet-adapter-protocol-kit",
    "description": "A convenience wrapper that enables you to call Solana Mobile Stack protocol methods using objects from @solana/kit",
    "version": "0.4.0",
    "author": "Marco Martinez <marco.martinez@solana.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/solana-mobile/mobile-wallet-adapter.git"
    },
    "license": "Apache-2.0",
    "exports": {
        "types": "./lib/types/index.d.ts",
        "browser": "./lib/esm/index.browser.js",
        "react-native": "./lib/esm/index.native.js",
        "default": "./lib/esm/index.js"
    },
    "browser": {
        "./lib/esm/index.js": "./lib/esm/index.browser.js"
    },
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "react-native": "lib/esm/index.native.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "files": [
        "lib",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx rm -rf lib/*",
        "build": "pnpm clean && tsdown --config ../../tsdown.config.ts",
        "build:watch": "pnpm clean && tsdown --config ../../tsdown.config.ts --watch",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "agadoo"
    },
    "peerDependencies": {
        "@solana/kit": "^7.0.0 || ^8.0.0"
    },
    "dependencies": {
        "@solana-mobile/mobile-wallet-adapter-protocol": "workspace:^",
        "@solana/transaction-messages": "^8.2.0",
        "@solana/transactions": "^8.2.0"
    },
    "devDependencies": {
        "@solana/keys": "^8.0.0",
        "@solana/kit": "^8.0.0",
        "agadoo": "^3.0.0",
        "cross-env": "^10.1.0",
        "shx": "^0.4.0"
    }
}
