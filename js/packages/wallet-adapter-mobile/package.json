{
    "name": "@solana-mobile/wallet-adapter-mobile",
    "description": "An adapter for mobile wallet apps that conform to the Solana Mobile Wallet Adapter protocol",
    "version": "2.3.0",
    "author": "Steven Luscher <steven.luscher@solanamobile.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/solana-mobile/mobile-wallet-adapter.git"
    },
    "license": "Apache-2.0",
    "exports": {
        "types": "./lib/types/index.d.ts",
        "browser": "./lib/esm/index.browser.js",
        "react-native": "./lib/esm/index.native.js",
        "default": "./lib/esm/index.js"
    },
    "browser": {
        "./lib/esm/index.js": "./lib/esm/index.browser.js"
    },
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "react-native": "lib/esm/index.native.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "files": [
        "lib",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx rm -rf lib/*",
        "build": "pnpm clean && tsdown --config ../../tsdown.config.ts",
        "build:watch": "pnpm clean && tsdown --config ../../tsdown.config.ts --watch",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "agadoo"
    },
    "peerDependencies": {
        "@react-native-async-storage/async-storage": "^1.17.7 || ^2.0.0",
        "@solana/web3.js": "^1.98.4",
        "react-native": ">0.74"
    },
    "peerDependenciesMeta": {
        "@react-native-async-storage/async-storage": {
            "optional": true
        },
        "react-native": {
            "optional": true
        }
    },
    "dependencies": {
        "@solana-mobile/mobile-wallet-adapter-protocol": "workspace:^",
        "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "workspace:^",
        "@solana-mobile/wallet-standard-mobile": "workspace:^",
        "@solana/wallet-adapter-base": "^0.9.27",
        "@solana/wallet-standard-features": "^1.3.0",
        "@wallet-standard/core": "^1.1.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@solana/web3.js": "^1.98.4",
        "@types/react-native": "^0.69.3",
        "agadoo": "^3.0.0",
        "cross-env": "^10.1.0",
        "shx": "^0.4.0"
    }
}
