{
    "name": "root",
    "private": true,
    "packageManager": "pnpm@10.30.0",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "changeset:check": "node ./scripts/check-changesets.mjs",
        "check-types": "tsc -p tsconfig.json --noEmit && turbo run check-types",
        "clean": "turbo run clean",
        "format:check": "prettier . --check --cache",
        "format:fix": "prettier . --write",
        "lint:check": "eslint . --ext .cjs,.cts,.js,.mjs,.mts,.ts,.tsx",
        "lint:fix": "eslint . --ext .cjs,.cts,.js,.mjs,.mts,.ts,.tsx --fix",
        "publish-packages": "pnpm build && pnpm changeset publish",
        "test": "vitest",
        "test:coverage": "vitest run --coverage.enabled"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@types/node": "26.6.6",
        "@types/node-fetch": "^2.6.13",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^10.14.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "jsdom": "^30.1.2",
        "prettier": "3.9.10",
        "shx": "^0.4.0",
        "tsdown": "^0.23.5",
        "turbo": "^2.11.10",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.3"
    },
    "pnpm": {
        "overrides": {
            "jayson@<5.0.0": "^5.0.0"
        }
    }
}
